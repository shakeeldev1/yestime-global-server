NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/yestime_global

CLIENT_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,https://yestimeglobal.com,https://www.yestimeglobal.com

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# SMTP settings used to send OTP emails. Port 587 uses STARTTLS; port 465 uses implicit TLS.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@your-domain.com
SMTP_PASS=your_email_password
# Use the authenticated mailbox address or a sender alias configured with the provider.
MAIL_FROM="Your Brand <your_email@your-domain.com>"
ADMIN_EMAIL=info@yestimeglobal.com

# Cloudinary stores payment screenshots; these are required for submissions.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

OTP_EXPIRES_IN_MINUTES=10

# Lottery draw scheduler — runs draws automatically in-process.
# Set to false to disable auto-running (e.g. when running multiple server
# replicas, where only one instance should schedule draws).
ENABLE_DRAW_SCHEDULER=true
DRAW_INTERVAL_SECONDS=62
