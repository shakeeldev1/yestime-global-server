NODE_ENV=development
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/yestime_global

CLIENT_URL=http://localhost:3000

JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# SMTP settings used to send OTP emails (signup verification, password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password_or_app_password
MAIL_FROM="Yestime Global <no-reply@yestime.com>"
ADMIN_EMAIL=info@yestimeglobal.com

# Cloudinary stores payment screenshots; these are required for submissions.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

OTP_EXPIRES_IN_MINUTES=10

# Lottery draw scheduler — runs draws automatically in-process.
# Set to false to disable auto-running (e.g. when running multiple server
# replicas, where only one instance should schedule draws).
ENABLE_DRAW_SCHEDULER=true
DRAW_INTERVAL_SECONDS=62
